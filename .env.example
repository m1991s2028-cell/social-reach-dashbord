# انسخ هذا الملف باسم .env ولا ترفعه إلى GitHub أبدًا.

PORT=3000

# ===== YouTube (YouTube Data API v3 — مفتاح API عادي) =====
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ===== Meta: Facebook Page + Instagram Business (Graph API) =====
# Page Access Token طويل الأمد بصلاحيات:
# pages_read_engagement, pages_read_user_content, instagram_basic, instagram_manage_insights
META_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ===== TikTok (TikTok API v2 — Access Token عبر OAuth لحساب المستخدم) =====
TIKTOK_ACCESS_TOKEN=

# ===== الجدولة =====
# اتركه فارغًا لسحب البيانات كل ساعة (القيمة الافتراضية: "0 * * * *")
# لاختبار سريع أثناء التطوير يمكنك مؤقتًا استخدام "*/5 * * * *" (كل 5 دقائق)
REFRESH_CRON=

# اجعلها true إذا أردت سحب فوري عند تشغيل السيرفر أول مرة (بدل انتظار الساعة القادمة)
RUN_ON_START=false
